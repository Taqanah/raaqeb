#!/bin/sh
# Refuse commits made while HEAD is main or a release branch. Work reaches them
# through a reviewed pull request, never a direct commit. Install once per clone:
#   git config core.hooksPath .githooks
branch=$(git symbolic-ref --short -q HEAD)
case "$branch" in
main | release-*)
  echo "pre-commit: refusing to commit on $branch. Create a branch: git switch -c <number>-<slug>" >&2
  exit 1
  ;;
esac
