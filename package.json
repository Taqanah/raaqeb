{
  "name": "raaqeb",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "bench": "bun bench/floor/run.ts",
    "bench:record": "bun bench/floor/record.ts",
    "binaries": "bun run build && bun scripts/package.ts binaries",
    "browser": "agent-browser",
    "build": "bun run catalog && vite build",
    "catalog": "bun scripts/catalog.ts write",
    "catalog:check": "bun scripts/catalog.ts check",
    "check": "ultracite check",
    "db:generate": "bun scripts/db-generate.ts",
    "design:shots": "bun scripts/design-shots.ts",
    "dev": "bun run catalog && vite dev",
    "docs:pull": "bun scripts/pull-docs.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "fix": "ultracite fix",
    "gate": "bun run catalog:check && bun run check && bun run typecheck && bun run build && bun run test",
    "image": "bun run binaries && bun scripts/package.ts image",
    "image:check": "bun run image && bun scripts/image-check.ts",
    "install:check": "bun run binaries && bun scripts/install-check.ts",
    "start": "bun dist/server/server.js",
    "test": "bun run catalog && bun test src scripts bench website --parallel",
    "test:postgres": "bun scripts/test-postgres.ts",
    "typecheck": "bun --check && bun --cwd=website --check",
    "upgrade:check": "bun scripts/upgrade-check.ts",
    "website": "vite dev --config website/vite.config.ts",
    "website:build": "vite build --config website/vite.config.ts",
    "zones": "bun scripts/zone-cities.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fumadocs/base-ui": "16.17.1",
    "@lingui/cli": "6.9.1",
    "@playwright/test": "1.64.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/start-static-server-functions": "1.167.39",
    "@types/bun": "1.4.3",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "agent-browser": "0.39.0",
    "drizzle-kit": "1.0.0-rc.4",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vite": "8.3.4"
  }
}
